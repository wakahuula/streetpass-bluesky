{
  "name": "streetpass-bluesky",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --watch",
    "site": "node scripts/site.ts",
    "screenshots": "node build.ts --target=chrome && node scripts/screenshots.ts",
    "store-assets": "node scripts/store-assets.ts",
    "firefox": "node build.ts --target=firefox && npx --yes web-ext@10.8.0 run --source-dir dist/firefox",
    "lint:firefox": "npx --yes web-ext@10.8.0 lint --source-dir dist/firefox --warnings-as-errors",
    "check": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
